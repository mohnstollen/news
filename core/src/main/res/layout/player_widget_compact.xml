<?xml version="1.0" encoding="utf-8"?>
<!-- Player widget, lowest: episode and play/pause; no room for the cover. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pw_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="8dp">

    <LinearLayout
        android:id="@+id/pw_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingEnd="6dp"
        android:paddingStart="4dp">

        <TextView
            android:id="@+id/pw_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/app_name"
            android:textColor="@color/widget_text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/pw_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/player_widget_preview"
            android:textColor="@color/widget_text_secondary"
            android:textSize="11sp" />

        <Chronometer
            android:id="@+id/pw_detail_clock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_text_secondary"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/pw_play"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/player_widget_play_background"
        android:contentDescription="@string/player_widget_play"
        android:layout_gravity="center"
        android:src="@drawable/ic_player_widget_play" />
</LinearLayout>

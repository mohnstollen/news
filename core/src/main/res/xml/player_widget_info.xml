<?xml version="1.0" encoding="utf-8"?>
<!--
    Podfang's player. One widget for all sizes: with the cover from 2×1, with all buttons from 4×1
    and with the next episodes from 4×2 (see PlayerWidget.Layout). It is redrawn when playback or
    the queue change, so updatePeriodMillis is 0.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/player_widget_description"
    android:initialLayout="@layout/player_widget_large"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="40dp"
    android:previewLayout="@layout/player_widget_large"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />

<?xml version="1.0" encoding="utf-8"?>
<!-- News, the RSS reader: no podcast playback, no episode downloads. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" tools:node="remove" />

    <application
        android:name="io.github.mohnstollen.news.reader.ReaderApp"
        tools:replace="android:name">

        <service android:name="io.github.mohnstollen.news.playback.PlaybackService" tools:node="remove" />
        <service android:name="androidx.work.impl.foreground.SystemForegroundService" tools:node="remove" />
    </application>
</manifest>
